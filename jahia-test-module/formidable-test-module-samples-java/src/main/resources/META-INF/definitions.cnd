<jnt = 'http://www.jahia.org/jahia/nt/1.0'>
<fmdb = 'http://www.jahia.org/jahia/fmdb/nt/1.0'>
<fmdbmix = 'http://www.jahia.org/jahia/fmdb/mix/1.0'>
<fmdbsample = 'http://www.jahia.org/jahia/fmdbsample/nt/1.0'>
<fmdbsamplemix = 'http://www.jahia.org/jahia/fmdb/sample/mix/1.0'>

[fmdbsample:logSubmissionAction] > jnt:content, fmdbmix:formAction, mix:title

// The opt-in of the sample response enricher: only a form carrying this mixin gets the sample block
// in the JSON body of an accepted submission. An enricher is asked for every submission of the
// platform, so gating on something the author set is what keeps a module's key out of every other
// form's response — the part of the sample worth copying into a real module.
//
// No `extends`, deliberately: this is a test module, and a mixin extending fmdb:form would offer
// itself in the editor of every form of every site the module is deployed on. The Cypress spec adds
// it to its own fixtures; a real module would extend the type it means to offer it on.
//
// The fmdbsamplemix prefix is the one the tsx samples module already declares, with its URI: a
// prefix is global to the platform, so binding it to a URI of this module's own would have taken it
// from that module and left its own types unregistered — which is exactly what happened once.
[fmdbsamplemix:enrichedResponse] mixin
 itemtype = content

// A field action written in Java, the shape a module of its own copies (docs/architecture/field-actions.md,
// "A field action in Java"): the type takes fmdbmix:fieldAction as a supertype, carries its own settings
// — here the words that make a value unwelcome — and a FieldAction OSGi service bound to the type judges the
// value. The visitor's message, the trigger, the severity and the outage rule reach the type through the
// engine's fmdbmix:fieldActionFeedback, unasked. Exercised by the test suite against the pre-check endpoint
// and the submission pipeline.
[fmdbsample:blockedWordsAction] > jnt:content, fmdbmix:fieldAction, mix:title
 - jcr:title (string) = resourceBundle('fmdbsample_blockedWordsAction') autocreated i18n
 - words (string) multiple indexed=no

// A second field action of the samples, and the one a real project is most likely to want: does the domain of the
// address exist? It asks the domain name system, needs no provider and no configuration, and refuses one thing only
// — a domain the resolver denies, which is the mistyped domain. Shipped as a sample rather than by the engine: the
// engine provides the mechanism, a project decides which checks its forms deserve.
[fmdbsample:emailDomainAction] > jnt:content, fmdbmix:fieldAction, mix:title
 - jcr:title (string) = resourceBundle('fmdbsample_emailDomainAction') autocreated i18n

// A third field action of the samples, and an example implementation rather than a supported connector: the
// mailbox check a project wants once the domain check is not enough, written out in full against one provider,
// Experian Email Validation v2, on the engine's EmailVerificationFieldAction. The contributor has no service to pick:
// the action reads where Experian is and the account's token from its own configuration
// (org.jahia.test.modules.formidable.samples.experian), and the service's confidence becomes the verdict
// (docs/architecture/field-actions.md, "Email verification behind a provider"). Exercised by the test suite against
// the samples' own double of the service, ExperianStubServlet, which the samples' configuration points at.
[fmdbsample:experianEmailAction] > jnt:content, fmdbmix:fieldAction, mix:title
 - jcr:title (string) = resourceBundle('fmdbsample_experianEmailAction') autocreated i18n

// The same check against another service, ZeroBounce, on the same engine base — the shape to copy for a third:
// the type, the action's own configuration (org.jahia.test.modules.formidable.samples.zerobounce), the mapping of
// the service's vocabulary, nothing else. ZeroBounce reads its key off the URL, as a query parameter. Exercised
// against ZeroBounceStubServlet.
[fmdbsample:zeroBounceEmailAction] > jnt:content, fmdbmix:fieldAction, mix:title
 - jcr:title (string) = resourceBundle('fmdbsample_zeroBounceEmailAction') autocreated i18n

// "Save to JCR, without the private fields": the engine's Save to JCR, minus the fields the author marked
// private. A form action of this module (SavePublicToJcrFormAction), which hands the engine's own storage service
// the values it may keep. Used instead of the standard fmdb:save2jcrAction, not next to it.
[fmdbsample:savePublicToJcrAction] > jnt:content, fmdbmix:formAction, mix:title
 - jcr:title (string) = resourceBundle('fmdbsample_savePublicToJcrAction') autocreated i18n

// The author's "private field" switch, closing the Field settings section of a field's editor (placed there by
// META-INF/jahia-content-editor-forms/forms/fmdbsamplemix_privateData.json, "alwaysPresent": a switch without a
// property of its own is dropped once moved otherwise). `extends = fmdbmix:submittableField` offers it on every
// field with a value, third-party included, and on nothing else: not on a file field, which is stored as usual.
// A pure marker: its presence is the flag, SavePublicToJcrFormAction reads it. Nothing of the engine reads it, so
// the standard Save to JCR still stores the field.
[fmdbsamplemix:privateData] mixin
 extends = fmdbmix:submittableField
